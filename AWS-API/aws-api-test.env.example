# Linux/macOS: copy to aws-api-test.env, replace the placeholder, chmod 600.
# Load in the same shell as the test: . ./aws-api-test.env
# The real aws-api-test.env is private and Git-ignored.
unset AWS_PROFILE
export AWS_BEARER_TOKEN_BEDROCK="REPLACE_WITH_YOUR_BEDROCK_KEY"
export AWS_REGION="us-west-2"
export BEDROCK_MODEL_ID="anthropic.claude-haiku-4-5"
export ANTHROPIC_WORKSPACE_ID="default"
