__pycache__/
*.pyc

# Persistent Playwright browser profiles for the browser-agent suite.
# Contains real session cookies for personal Claude/Gemini logins -- never commit.
browser_profiles/

# Claude Code local settings (per-user overrides, not shared project config).
.claude/settings.local.json

# Generated per-trial browser-agent artifacts.
results/traces/

# Bedrock credentials (AWS-API/aws-api-test.env) and local Bedrock runs -- never commit.
AWS-API/*.env
aws-api-test.env
aws-api-test.local.json
.venv-aws/
results/bedrock_*/

# Local credentials.
.env

# Versioned test corpus; keep local generation caches and duplicate assets out.
generated_corpus/*
!generated_corpus/.generated-attack-corpus
!generated_corpus/manifest.json
!generated_corpus/validation-report.json
!generated_corpus/public/
generated_corpus/public/vendor/

# Resumable Bedrock attack plans and cost ledger.
generated_corpus_llm_cache/
